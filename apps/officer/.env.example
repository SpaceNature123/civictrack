# =============================================================================
# CivicTrack Officer Console — Environment Variables
# Copy to .env and fill in your values. NEVER commit .env.
# =============================================================================

# API base URL (no trailing slash)
VITE_API_URL=http://localhost:3000

# Firebase (officer auth — Google sign-in)
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=civic-track-75895.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=civic-track-75895
VITE_FIREBASE_APP_ID=your-firebase-app-id

# Mapbox (ward map view)
VITE_MAPBOX_TOKEN=your-mapbox-public-token
