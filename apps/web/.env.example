# =============================================================================
# CivicTrack Citizen Web App — Environment Variables
# Copy to .env and fill in your values. NEVER commit .env.
# =============================================================================

# API base URL (no trailing slash)
VITE_API_URL=http://localhost:3000

# Firebase (citizen auth — Google sign-in & Phone OTP)
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=civic-track-75895.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=civic-track-75895
VITE_FIREBASE_STORAGE_BUCKET=civic-track-75895.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=415593384543
VITE_FIREBASE_APP_ID=your-firebase-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id

# Mapbox (issue location picker map)
VITE_MAPBOX_TOKEN=your-mapbox-public-token

# Cloudinary (image uploads from browser)
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-unsigned-upload-preset
