{
  "name": "@civictrack/api",
  "version": "0.0.1",
  "private": true,
  "description": "CivicTrack NestJS REST API",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "ts-node-dev --respawn --transpile-only --require tsconfig-paths/register src/main.ts",
    "start": "node dist/main.js",
    "start:debug": "node --inspect dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"{src,test,migrations}/**/*.ts\" --max-warnings 0",
    "migration:run": "ts-node -r tsconfig-paths/register scripts/migrate.ts",
    "migration:revert": "ts-node -r tsconfig-paths/register scripts/revert.ts",
    "seed": "ts-node --transpile-only -r tsconfig-paths/register src/database/seeds/seed.ts",
    "test": "jest --config jest.config.ts --testPathPatterns=\"src/.*\\.spec\\.ts$\"",
    "test:integration": "jest --config jest.config.ts --testPathPatterns=\"test/.*\\.integration\\.spec\\.ts$\" --runInBand --forceExit"
  },
  "dependencies": {
    "@civictrack/shared": "workspace:*",
    "@nestjs/common": "^10.3.10",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^10.3.10",
    "@nestjs/platform-express": "^10.3.10",
    "@nestjs/typeorm": "^10.0.2",
    "dotenv": "^17.4.2",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.1.4",
    "@nestjs/testing": "^10.3.10",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.14.12",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "jest": "^30.4.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.5.4"
  }
}
