# =============================================================================
# CivicTrack API — Environment Variables
# Copy to .env and fill in your values. NEVER commit .env.
# =============================================================================

# Server
PORT=3000
NODE_ENV=development

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Database (PostgreSQL + PostGIS)
DATABASE_URL=postgresql://civictrack:civictrack@localhost:5432/civictrack

# Redis
REDIS_URL=redis://:civictrack@localhost:6379

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# Firebase Admin (for phone OTP + push notifications)
FIREBASE_PROJECT_ID=civic-track-75895
FIREBASE_PRIVATE_KEY=your-firebase-private-key
FIREBASE_CLIENT_EMAIL=your-firebase-service-account-email

# Cloudinary (image storage)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Twilio (SMS / WhatsApp)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Mapbox (geocoding / reverse geocoding)
MAPBOX_ACCESS_TOKEN=your-mapbox-token

# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@civictrack.in
SMTP_PASS=your-smtp-password
SMTP_FROM="CivicTrack <noreply@civictrack.in>"

# BullMQ / Queue config
QUEUE_CONCURRENCY=5
